# Server-side only. Never use NEXT_PUBLIC_ for API keys.
NEBIUS_API_KEY=
# Optional; must appear in the live /models response and be NVIDIA Nemotron.
NEBIUS_MODEL=
TAVILY_API_KEY=
# PostgreSQL required for durable multi-instance hosted booking.
DATABASE_URL=
# Only for separately hosted frontend; Vercel Services routes /api directly.
FASTAPI_URL=http://127.0.0.1:8000
# Demo SQLite file path; local-only persistence by default.
REVSlot_DB_PATH=
